# Copie este archivo a .env (o exporte las variables). NUNCA suba .env a GitHub.
PORT=3000
DATA_DIR=./data

# Conector OpenAI Imágenes (opcional, de pago por uso). Sin clave el conector queda "no configurado".
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Costo estimado por imagen en USD: configúrelo con el precio vigente de su cuenta (verifíquelo en openai.com/api/pricing).
# Si se deja vacío, el sistema mostrará "costo no configurado" y no inventará cifras.
OPENAI_IMAGE_COST_USD=
