# Copie este archivo a .env. NUNCA suba .env a GitHub.
PORT=3000
DATA_DIR=./data

# --- Motores de IA LOCALES y GRATUITOS (todos opcionales) ---
# Ollama (https://ollama.com): textos, visión de fotos e imagen experimental. Valor por defecto: http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
# Modelo de texto/visión por defecto. Recomendado para un PC sin GPU: gemma4:e2b (texto + imágenes). Instálelo con: ollama pull gemma4:e2b
OLLAMA_TEXT_MODEL=gemma4:e2b
# Tiempo máximo de espera por respuesta (ms). En CPU conviene dejar margen.
OLLAMA_TIMEOUT_MS=300000
# Tamaño máximo (px del lado mayor) pedido a modelos de imagen de Ollama
OLLAMA_IMAGE_MAX_SIDE=1024

# Stable Diffusion WebUI (AUTOMATIC1111/Forge/SD.Next iniciado con --api). Vacío = desactivado.
SD_WEBUI_URL=
SD_WEBUI_MAX_SIDE=768
